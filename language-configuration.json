{
  "comments": {
    "lineComment": "//",
    "blockComment": [
      "{",
      "}"
    ]
  },
  "brackets": [
    ["{", "}"],
    ["(", ")"],
    ["[", "]"]
  ],
  "autoClosingPairs": [
    { "open": "{", "close": "}" },
    { "open": "(", "close": ")" },
    { "open": "[", "close": "]" },
    { "open": "'", "close": "'", "notIn": ["string", "comment"] },
    { "open": "'''", "close": "'''", "notIn": ["string", "comment"] }
  ],
  "surroundingPairs": [
    ["{", "}"],
    ["(", ")"],
    ["[", "]"],
    ["'", "'"]
  ],
  "wordPattern": "(-?\\d+(?:\\.\\d+)?)|([A-Za-z_][A-Za-z0-9_]*)",
  "indentationRules": {
    "increaseIndentPattern": "\\b(begin|case|try)\\b(?!.*\\bend\\b)",
    "decreaseIndentPattern": "^\\s*\\bend\\b"
  },
  "folding": {
    "offSide": false,
    "markers": {
      "start": "^\\s*\\{\\$region\\b",
      "end": "^\\s*\\{\\$endregion\\b"
    }
  }
}
