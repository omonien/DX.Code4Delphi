{
  "name": "code4delphi",
  "displayName": "Code4Delphi — Delphi Language Support",
  "description": "Code4Delphi: modern, high quality syntax highlighting and Delphi-IDE style code navigation (Ctrl+Shift+Up/Down, Alt+Up/Down) for Delphi 13.1 and all older versions. By Developer Experts, LLC.",
  "version": "2.0.2",
  "publisher": "DeveloperExperts",
  "author": "Developer Experts, LLC",
  "license": "MIT",
  "homepage": "https://www.developer-experts.net",
  "repository": {
    "type": "git",
    "url": "https://github.com/omonien/DX.Code4Delphi.git"
  },
  "bugs": {
    "url": "https://github.com/omonien/DX.Code4Delphi/issues"
  },
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "keywords": [
    "delphi",
    "pascal",
    "object pascal",
    "code4delphi",
    "embarcadero",
    "rad studio",
    "language",
    "syntax"
  ],
  "icon": "media/icon.png",
  "galleryBanner": {
    "color": "#f7f8fa",
    "theme": "light"
  },
  "activationEvents": [
    "onLanguage:delphi",
    "onLanguage:delphi-form"
  ],
  "main": "./src/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "delphi",
        "aliases": [
          "Delphi",
          "Object Pascal",
          "Pascal"
        ],
        "extensions": [
          ".pas",
          ".pp",
          ".dpr",
          ".dpk",
          ".inc",
          ".p",
          ".int"
        ],
        "filenames": [
          "*.dpr"
        ],
        "configuration": "./language-configuration.json"
      },
      {
        "id": "delphi-form",
        "aliases": [
          "Delphi Form",
          "DFM",
          "FMX"
        ],
        "extensions": [
          ".dfm",
          ".fmx"
        ],
        "configuration": "./language-configuration-form.json"
      }
    ],
    "grammars": [
      {
        "language": "delphi",
        "scopeName": "source.delphi",
        "path": "./syntaxes/delphi.tmLanguage.json"
      },
      {
        "language": "delphi-form",
        "scopeName": "source.delphi-form",
        "path": "./syntaxes/delphi-form.tmLanguage.json"
      }
    ],
    "commands": [
      {
        "command": "delphi.goToImplementation",
        "title": "Go to Method Implementation / Interface Section",
        "category": "Code4Delphi"
      },
      {
        "command": "delphi.goToDeclaration",
        "title": "Go to Method Declaration / Implementation Section",
        "category": "Code4Delphi"
      },
      {
        "command": "delphi.nextMethod",
        "title": "Next Method (Declaration or Implementation)",
        "category": "Code4Delphi"
      },
      {
        "command": "delphi.previousMethod",
        "title": "Previous Method (Declaration or Implementation)",
        "category": "Code4Delphi"
      },
      {
        "command": "delphi.selectColorScheme",
        "title": "Select Color Scheme (Syntax Highlighting)",
        "category": "Code4Delphi"
      },
      {
        "command": "delphi.selectKeybindingStyle",
        "title": "Select Keybinding Style",
        "category": "Code4Delphi"
      },
      {
        "command": "delphi.showFormLayout",
        "title": "Show Form Layout (Box Model)",
        "category": "Code4Delphi"
      }
    ],
    "keybindings": [
      {
        "command": "delphi.goToImplementation",
        "key": "ctrl+shift+down",
        "when": "editorLangId == delphi && editorTextFocus && config.delphi.navigation.enabled && config.delphi.keybindings.style == 'default'"
      },
      {
        "command": "delphi.goToDeclaration",
        "key": "ctrl+shift+up",
        "when": "editorLangId == delphi && editorTextFocus && config.delphi.navigation.enabled && config.delphi.keybindings.style == 'default'"
      },
      {
        "command": "delphi.goToImplementation",
        "key": "ctrl+alt+down",
        "when": "editorLangId == delphi && editorTextFocus && config.delphi.navigation.enabled && config.delphi.keybindings.style == 'default'"
      },
      {
        "command": "delphi.goToDeclaration",
        "key": "ctrl+alt+up",
        "when": "editorLangId == delphi && editorTextFocus && config.delphi.navigation.enabled && config.delphi.keybindings.style == 'default'"
      },
      {
        "command": "delphi.nextMethod",
        "key": "alt+down",
        "when": "editorLangId == delphi && editorTextFocus && config.delphi.navigation.enabled && config.delphi.keybindings.style == 'default'"
      },
      {
        "command": "delphi.previousMethod",
        "key": "alt+up",
        "when": "editorLangId == delphi && editorTextFocus && config.delphi.navigation.enabled && config.delphi.keybindings.style == 'default'"
      },
      {
        "command": "delphi.goToImplementation",
        "key": "alt+.",
        "when": "editorLangId == delphi && editorTextFocus && config.delphi.navigation.enabled && config.delphi.keybindings.style == 'emacs'"
      },
      {
        "command": "delphi.goToDeclaration",
        "key": "alt+,",
        "when": "editorLangId == delphi && editorTextFocus && config.delphi.navigation.enabled && config.delphi.keybindings.style == 'emacs'"
      },
      {
        "command": "delphi.nextMethod",
        "key": "ctrl+alt+n",
        "when": "editorLangId == delphi && editorTextFocus && config.delphi.navigation.enabled && config.delphi.keybindings.style == 'emacs'"
      },
      {
        "command": "delphi.previousMethod",
        "key": "ctrl+alt+p",
        "when": "editorLangId == delphi && editorTextFocus && config.delphi.navigation.enabled && config.delphi.keybindings.style == 'emacs'"
      },
      {
        "command": "delphi.goToImplementation",
        "key": "ctrl+q ctrl+down",
        "when": "editorLangId == delphi && editorTextFocus && config.delphi.navigation.enabled && config.delphi.keybindings.style == 'wordstar'"
      },
      {
        "command": "delphi.goToDeclaration",
        "key": "ctrl+q ctrl+up",
        "when": "editorLangId == delphi && editorTextFocus && config.delphi.navigation.enabled && config.delphi.keybindings.style == 'wordstar'"
      },
      {
        "command": "delphi.nextMethod",
        "key": "ctrl+q ctrl+n",
        "when": "editorLangId == delphi && editorTextFocus && config.delphi.navigation.enabled && config.delphi.keybindings.style == 'wordstar'"
      },
      {
        "command": "delphi.previousMethod",
        "key": "ctrl+q ctrl+p",
        "when": "editorLangId == delphi && editorTextFocus && config.delphi.navigation.enabled && config.delphi.keybindings.style == 'wordstar'"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "delphi.showFormLayout",
          "when": "editorLangId == delphi-form || editorLangId == delphi",
          "group": "navigation@1"
        }
      ]
    },
    "configuration": {
      "title": "Code4Delphi",
      "properties": {
        "delphi.navigation.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Master switch for all Delphi navigation keybindings (Ctrl+Shift+Up/Down, Ctrl+Alt+Up/Down, Alt+Up/Down). Rebind individual shortcuts in your keybindings.json if the defaults conflict."
        },
        "delphi.navigation.goToImplementation": {
          "type": "boolean",
          "default": true,
          "description": "Enable the 'Delphi: Go to Method Implementation / Interface Section' command and its shortcuts."
        },
        "delphi.navigation.goToDeclaration": {
          "type": "boolean",
          "default": true,
          "description": "Enable the 'Delphi: Go to Method Declaration / Implementation Section' command and its shortcuts."
        },
        "delphi.navigation.nextPreviousMethod": {
          "type": "boolean",
          "default": true,
          "description": "Enable the 'Delphi: Next / Previous Method' commands and their shortcuts."
        },
        "delphi.navigation.matchOverloads": {
          "type": "boolean",
          "default": true,
          "description": "When jumping between a method declaration and its implementation, compare parameter types so overloads resolve to the correct pair."
        },
        "delphi.navigation.jumpToSection": {
          "type": "boolean",
          "default": true,
          "description": "When the cursor is not on a method, jump between the 'interface' and 'implementation' section headers (like the Delphi IDE)."
        },
        "delphi.navigation.showStatusMessage": {
          "type": "boolean",
          "default": false,
          "description": "Show a status-bar message when a navigation jump succeeds or fails."
        },
        "delphi.keybindings.style": {
          "type": "string",
          "enum": [
            "default",
            "emacs",
            "wordstar"
          ],
          "enumDescriptions": [
            "Delphi IDE default: Ctrl+Shift+Up/Down, Ctrl+Alt+Up/Down, Alt+Up/Down.",
            "Emacs-style: Alt+. (find-tag), Alt+, (pop-tag-mark), Ctrl+Alt+N/P (structural next/previous).",
            "WordStar-style: Ctrl+Q Ctrl+Up/Down (sections), Ctrl+Q Ctrl+N/P (next/previous method)."
          ],
          "default": "default",
          "description": "Keybinding style for the Delphi navigation commands (like the keymap schemes of the Delphi IDE: Default, Emacs, WordStar)."
        },
        "delphi.colorScheme": {
          "type": "string",
          "enum": [
            "auto",
            "none",
            "fancy",
            "turboPascal",
            "delphiDark",
            "delphiLight"
          ],
          "enumDescriptions": [
            "Follow my VS Code theme automatically: Delphi Dark when my theme is dark, Delphi Light when it is light.",
            "No custom colors — Delphi is highlighted by your current VS Code theme.",
            "Code4Delphi Fancy — vivid, hand-tuned Delphi syntax colors.",
            "Code4Delphi Turbo Pascal — the classic Turbo Pascal IDE syntax colors (navy, yellow keywords, cyan strings).",
            "Code4Delphi Delphi Dark — Delphi 13 default dark editor syntax colors.",
            "Code4Delphi Delphi Light — Delphi 13 default light editor syntax colors."
          ],
          "default": "auto",
          "description": "Color scheme for the Delphi **syntax highlighting** only. The global VS Code theme is never changed — the selected scheme's colors are applied to Delphi files via per-language token colors (also available from the command palette: 'Code4Delphi: Select Color Scheme')."
        },
        "delphi.folding.sections": {
          "type": "boolean",
          "default": true,
          "description": "Provide fold regions for 'interface', 'implementation', 'initialization' and 'finalization' sections."
        },
        "delphi.folding.beginEnd": {
          "type": "boolean",
          "default": true,
          "description": "Provide fold regions for begin/end, case, try, record and class blocks."
        },
        "delphi.folding.regions": {
          "type": "boolean",
          "default": true,
          "description": "Provide fold regions for {$REGION} / {$ENDREGION} markers."
        },
        "delphi.folding.conditionals": {
          "type": "boolean",
          "default": true,
          "description": "Provide fold regions for {$IFDEF}, {$IF}, {$IFNDEF} / {$ENDIF}, {$IFEND} compiler directives."
        },
        "delphi.formLayout.labels.showName": {
          "type": "boolean",
          "default": true,
          "description": "Show the component name on each box in the form layout visualizer."
        },
        "delphi.formLayout.labels.showClassName": {
          "type": "boolean",
          "default": false,
          "description": "Show the class name on each box in the form layout visualizer."
        },
        "delphi.formLayout.labels.showCaption": {
          "type": "boolean",
          "default": false,
          "description": "Show the Caption or Text property value on each box in the form layout visualizer."
        },
        "delphi.formLayout.labels.showAlign": {
          "type": "boolean",
          "default": false,
          "description": "Show the Align value on each box in the form layout visualizer."
        }
      }
    }
  },
  "scripts": {
    "test": "node --test test/*.test.js",
    "test:grammar": "node --test test/grammar.test.js test/grammar-form.test.js",
    "test:parser": "node --test test/parser.test.js",
    "package": "vsce package",
    "test:formLayout": "node --test test/formLayout.test.js test/formLayoutView.test.js test/treeFilter.test.js",
    "test:webview": "node --test --test-concurrency=1 test/formLayout.webview.playwright.test.js"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@vscode/vsce": "^3.9.2",
    "playwright": "^1.62.1",
    "vscode-oniguruma": "1.7.0",
    "vscode-textmate": "8.0.0"
  }
}
